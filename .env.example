# Copy this file to .env (in the project root, next to docker-compose.yml).
#
# This is the ONLY settings file. docker-compose reads it automatically and hands
# each container just the variables it needs, so the backend never sees the
# website password and the web server never sees the ElevenLabs key.
#
# On the server:   chmod 600 .env
# It is never copied into a Docker image (.dockerignore) and never sent by
# deploy.ps1. Keep it out of any folder that gets shared or backed up publicly.


# --- website (used by the Caddy web server) ------------------------------

# Public domain name. Its DNS A record must point to this VPS.
DOMAIN=forge.rejected.cc

# Login for the website (HTTP basic auth).
BASIC_AUTH_USER=admin

# bcrypt hash of the website password. Generate it with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Cost 12 is recommended: strong for a human password, while cost 14 makes every
# login attempt cost about a second of server CPU, which a stranger hammering the
# page could use to slow the machine down.
# Keep the SINGLE QUOTES: the hash contains $ signs, which docker-compose would
# otherwise treat as variables, and the login would silently never work.
BASIC_AUTH_HASH='$2a$12$replace.this.with.the.output.of.caddy.hash-password'


# --- transcription (used by the backend) ---------------------------------

# ElevenLabs API key (https://elevenlabs.io/app/settings/api-keys).
# Needs the "Speech to Text" permission. Add "User: Read" as well if you want the
# website to show how many credits are left.
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Optional: cookies file for yt-dlp if YouTube asks to "confirm you're not a bot".
# Put the file in the data/ folder; this path is as seen INSIDE the container.
# That file is a live Google session, so chmod 600 it. Leave empty to not use cookies.
YTDLP_COOKIES=
# YTDLP_COOKIES=/data/youtube-cookies.txt


# --- model training (used by the GPU scripts, Part 2) --------------------

# Hugging Face token, needed because the IndicConformer checkpoint is gated.
# Create a "Read" token at https://huggingface.co/settings/tokens, and accept the
# model's terms on its page, or downloads return 403 even with a valid token.
HF_TOKEN=
