# A copy of the real site for automated browser checks, on localhost only.
#
# Identical to caddy/Caddyfile except that basic_auth is removed: the suite has the
# password hash but not the password, and the point is to test the page, not the login.
# Everything that could break rendering - the Content-Security-Policy in particular -
# is kept exactly as in production.
:8099 {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	header -Server

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
